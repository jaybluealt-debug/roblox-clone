{
  "name": "roblox-clone",
  "version": "0.1.0",
  "description": "A Roblox-inspired 3D game engine and platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "roblox",
    "game-engine",
    "3d-games",
    "multiplayer",
    "web-games"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0"
  }
}
